<odoo>
<record id="payment_contract_form" model="ir.ui.view"><field name="name">account.payment.contract.form</field><field name="model">account.payment</field><field name="inherit_id" ref="account.view_account_payment_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_contract_advance" string="Assign Contract Advance" type="object" groups="account.group_account_user" invisible="payment_type != 'inbound' or partner_type != 'customer' or state == 'draft'"/></xpath></field></record>
<record id="partner_contract_form" model="ir.ui.view"><field name="name">res.partner.contract.form</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_release_contract_retention" string="Release Retention" type="object" class="oe_stat_button" icon="fa-money" groups="account.group_account_user"/></xpath></field></record>
</odoo>