<odoo>
  <record id="advance_list" model="ir.ui.view"><field name="name">contract.advance.list</field><field name="model">contract.advance</field><field name="arch" type="xml"><list><field name="payment_id"/><field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="project_id"/><field name="date"/><field name="currency_id"/><field name="amount"/><field name="recovered"/><field name="remaining"/><field name="bank_settlement_state" string="Bank Settlement" widget="badge" decoration-success="bank_settlement_state == 'reconciled'" decoration-warning="bank_settlement_state == 'pending'"/><field name="registration_move_id"/></list></field></record>
  <record id="advance_form" model="ir.ui.view"><field name="name">contract.advance.form</field><field name="model">contract.advance</field><field name="arch" type="xml"><form><header><button name="action_register" string="Register Advance Liability" type="object" class="oe_highlight" invisible="registration_move_id" groups="account.group_account_user"/><button name="action_movements" string="Allocations" type="object"/><button name="action_create_bank_receipt" string="Create Bank Receipt" type="object" groups="account.group_account_user" invisible="not registration_move_id or receipt_move_id or bank_reconciled"/><button name="action_reconcile_payment" string="Reconcile Payment" type="object" groups="account.group_account_user" invisible="not registration_move_id or bank_reconciled"/><field name="bank_settlement_state" widget="statusbar" statusbar_visible="pending,reconciled"/></header><sheet><field name="bank_reconciled" invisible="1"/><widget name="web_ribbon" title="Reconciled" bg_color="text-bg-success" invisible="not bank_reconciled"/><group><field name="receipt_move_id" readonly="1" invisible="not receipt_move_id"/><field name="payment_id" readonly="registration_move_id" domain="[('payment_type', '=', 'inbound'), ('partner_type', '=', 'customer')]"/><field name="project_id" readonly="registration_move_id"/><field name="partner_id"/><field name="company_id"/><field name="currency_id"/><field name="date"/><field name="registration_move_id"/><field name="amount"/><field name="recovered"/><field name="remaining"/></group><div class="alert alert-info" role="status">Registration reclassifies the whole unreconciled payment credit to the configured liability. Confirm customer, project and currency before registering. The assignment is immutable afterwards.</div></sheet></form></field></record>
  <record id="retention_list" model="ir.ui.view"><field name="name">contract.retention.list</field><field name="model">contract.retention</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="invoice_id"/><field name="partner_id"/><field name="project_id"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/><field name="handover_date"/><field name="held"/><field name="released"/><field name="reversed_amount"/><field name="remaining"/><button name="action_release" string="Release" type="object" groups="account.group_account_user"/><button name="action_movements" string="History" type="object"/></list></field></record>
  <record id="retention_form" model="ir.ui.view"><field name="name">contract.retention.form</field><field name="model">contract.retention</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_release" string="Release Retention" type="object" groups="account.group_account_user"/><button name="action_movements" string="Accounting History" type="object"/></header><sheet><group><field name="invoice_id"/><field name="company_id"/><field name="partner_id"/><field name="project_id"/><field name="currency_id"/><field name="handover_date"/><field name="held"/><field name="released"/><field name="reversed_amount"/><field name="remaining"/></group><field name="movement_ids" readonly="1"/></sheet></form></field></record>
  <record id="movement_list" model="ir.ui.view"><field name="name">contract.movement.list</field><field name="model">contract.movement</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="date"/><field name="kind"/><field name="invoice_id"/><field name="partner_id"/><field name="project_id"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/><field name="amount"/><field name="company_currency_id"/><field name="company_amount"/><field name="move_id"/><field name="retention_id"/><field name="advance_id"/><field name="original_id"/></list></field></record>
  <record id="movement_form" model="ir.ui.view"><field name="name">contract.movement.form</field><field name="model">contract.movement</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="date"/><field name="kind"/><field name="invoice_id"/><field name="move_id"/><field name="company_id"/><field name="partner_id"/><field name="project_id"/><field name="currency_id"/><field name="amount"/><field name="company_currency_id"/><field name="company_amount"/><field name="retention_id"/><field name="advance_id"/><field name="original_id"/></group></sheet></form></field></record>
  <record id="advance_action" model="ir.actions.act_window"><field name="name">Customer Contract Advances</field><field name="res_model">contract.advance</field><field name="view_mode">list,form</field></record>
  <record id="retention_action" model="ir.actions.act_window"><field name="name">Contract Retention</field><field name="res_model">contract.retention</field><field name="view_mode">list,form</field></record>
  <record id="movement_action" model="ir.actions.act_window"><field name="name">Contract Accounting Movements</field><field name="res_model">contract.movement</field><field name="view_mode">list,form</field></record>
</odoo>

