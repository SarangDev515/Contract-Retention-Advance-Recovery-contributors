<odoo>
<record id="financial_report_landscape_paperformat" model="report.paperformat"><field name="name">Contract Report A4 Landscape</field><field name="default" eval="False"/><field name="format">A4</field><field name="orientation">Landscape</field><field name="margin_top">10</field><field name="margin_bottom">10</field><field name="margin_left">7</field><field name="margin_right">7</field><field name="header_line" eval="False"/><field name="header_spacing">0</field><field name="dpi">90</field></record>
<record id="financial_report_pdf_action" model="ir.actions.report"><field name="name">Contract Retention &amp; Advance Report</field><field name="model">contract.financial.report</field><field name="report_type">qweb-pdf</field><field name="report_name">contract_retention_advance.financial_report_print</field><field name="report_file">contract_retention_advance.financial_report_print</field><field name="paperformat_id" ref="financial_report_landscape_paperformat"/><field name="print_report_name">'Contract Report %s to %s' % (object.generated_date_from, object.generated_date_to)</field></record>
<template id="financial_report_print"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.basic_layout"><div class="page cra_print_report"><style>@page { size: A4 landscape; margin: 10mm 7mm; } .cra_print_report { font-family: Arial, sans-serif; } .cra_print_report h2 { text-align: center; font-size: 18px; } .cra_print_report .range { text-align: center; margin-bottom: 14px; font-size: 11px; } .cra_print_report table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 8px; } .cra_print_report th, .cra_print_report td { border: 1px solid #bbb; padding: 5px 3px; word-wrap: break-word; } .cra_print_report th { font-weight: bold; background: #eee; } .cra_print_report thead { display: table-header-group; } .cra_print_report tr { page-break-inside: avoid; } .cra_print_report .cra_customer_heading td { font-weight: 700; font-size: inherit; background: #f3f0f7; text-align: left; } .cra_print_report .number { text-align: right; } .cra_print_report .cra_print_subtotal td { font-weight: 700; background: #eee; border-top: 2px solid #777; } @media print { body { margin: 0; } }</style><h2>Contract Retention &amp; Advance Report</h2><div class="range">From <span t-field="doc.generated_date_from"/> To <span t-field="doc.generated_date_to"/></div><table><thead><tr><th>Customer</th><th>Company</th><th>Project</th><th>Currency</th><th>Gross invoiced</th><th>Net held</th><th>Released</th><th>Remaining retention</th><th>Advance received</th><th>Recovered</th><th>Remaining advance</th><th>Payable before cash</th><th>Company currency</th><th>Company retention</th><th>Company advance</th></tr></thead><tbody><t t-foreach="doc.line_ids" t-as="line"><tr t-if="line.display_type" class="cra_customer_heading"><td colspan="15"><span t-field="line.name"/></td></tr><tr t-else=""><td><span t-field="line.partner_id"/></td><td><span t-field="line.company_id"/></td><td><span t-field="line.project_id"/></td><td><span t-field="line.currency_id"/></td><td class="number"><span t-field="line.gross"/></td><td class="number"><span t-field="line.held"/></td><td class="number"><span t-field="line.released"/></td><td class="number"><span t-field="line.retention"/></td><td class="number"><span t-field="line.received"/></td><td class="number"><span t-field="line.recovered"/></td><td class="number"><span t-field="line.advance"/></td><td class="number"><span t-field="line.payable"/></td><td><span t-field="line.company_currency_id"/></td><td class="number"><span t-field="line.company_retention"/></td><td class="number"><span t-field="line.company_advance"/></td></tr></t><t t-foreach="doc._print_subtotals()" t-as="subtotal"><tr class="cra_print_subtotal"><td>Subtotal</td><td><span t-out="subtotal['company'].display_name"/></td><td></td><td><span t-out="subtotal['currency'].name"/></td><td class="number"><span t-out="subtotal['gross']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['held']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['released']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['retention']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['received']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['recovered']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['advance']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td class="number"><span t-out="subtotal['payable']" t-options="{'widget': 'monetary', 'display_currency': subtotal['currency']}"/></td><td><span t-out="subtotal['company_currency'].name"/></td><td class="number"><span t-out="subtotal['company_retention']" t-options="{'widget': 'monetary', 'display_currency': subtotal['company_currency']}"/></td><td class="number"><span t-out="subtotal['company_advance']" t-options="{'widget': 'monetary', 'display_currency': subtotal['company_currency']}"/></td></tr></t><tr t-if="not doc.line_ids"><td colspan="15">No transactions match the generated report.</td></tr></tbody></table></div></t></t></t></template>
</odoo>