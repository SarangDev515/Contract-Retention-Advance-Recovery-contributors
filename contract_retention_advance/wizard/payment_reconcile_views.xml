<odoo>
  <record id="payment_reconcile_wizard_form" model="ir.ui.view">
    <field name="name">contract.payment.reconcile.wizard.form</field>
    <field name="model">contract.payment.reconcile.wizard</field>
    <field name="arch" type="xml">
      <form string="Reconcile Payment">
        <field name="candidate_ids" invisible="1"/>
        <field name="no_candidates" invisible="1"/>
        <group>
          <field name="advance_id" options="{'no_open': True}"/>
          <field name="payment_id"/>
          <field name="company_id" groups="base.group_multi_company"/>
          <field name="currency_id"/>
          <field name="account_id"/>
          <field name="outstanding_amount"/>
          <field name="receipt_line_id" domain="[('id', 'in', candidate_ids)]" options="{'no_create': True, 'no_create_edit': True}"/>
          <field name="receipt_move_id"/>
          <field name="receipt_reference"/>
        </group>
        <div class="alert alert-warning" invisible="not no_candidates">No eligible posted bank receipt exists. Cancelled, missing, partial, different-customer and unequal-amount entries cannot be matched. This wizard does not create a receipt.</div>
        <div class="alert alert-info">This matches existing Outstanding Receipts only. Advance recovered and remaining amounts are unchanged. Odoo computes the payment status; this action never forces Paid.</div>
        <footer>
          <button name="action_reconcile" string="Confirm Reconciliation" type="object" class="btn-primary" groups="account.group_account_user" invisible="no_candidates"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="bank_receipt_wizard_form" model="ir.ui.view">
    <field name="name">contract.bank.receipt.wizard.form</field>
    <field name="model">contract.bank.receipt.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Bank Receipt">
        <group><field name="advance_id"/><field name="payment_id"/><field name="company_id" invisible="1"/><field name="currency_id"/><field name="amount"/><field name="date"/><field name="journal_id" required="1" options="{'no_create': True, 'no_create_edit': True}"/><field name="reference" required="1"/><field name="received_confirmed"/></group>
        <div class="alert alert-warning">This creates one DRAFT bank receipt only: debit the payment journal Bank account and credit Outstanding Receipts. Confirm the money actually arrived and is not already recorded. Review and post the draft separately, then return to Reconcile Payment.</div>
        <footer><button name="action_create_draft" string="Create Draft Receipt" type="object" class="btn-primary" groups="account.group_account_user"/><button string="Cancel" special="cancel"/></footer>
      </form>
    </field>
  </record>
</odoo>
