<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Retention release -->
    <record id="release_form" model="ir.ui.view">
        <field name="name">contract.retention.release.form</field>
        <field name="model">contract.retention.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <group>
                    <field name="company_id"/>
                    <field name="partner_id"/>
                    <field name="project_id"/>
                    <field name="currency_id"/>
                    <field name="date"/>
                    <field name="journal_id"
                           domain="[('company_id', '=', company_id), ('type', '=', 'general')]"/>
                    <field name="description"/>
                    <field name="retention_ids"
                           widget="many2many_tags"
                           domain="[('company_id', '=', company_id), ('currency_id', '=', currency_id)]"/>
                    <field name="invoice_ids" widget="many2many_tags"/>
                    <field name="available"/>
                    <field name="amount"/>
                    <field name="processed_move_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_release"
                            string="Post Release"
                            type="object"
                            class="btn-primary"
                            invisible="processed_move_id"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Single-screen financial report -->
    <record id="financial_report_form" model="ir.ui.view">
        <field name="name">contract.financial.report.form</field>
        <field name="model">contract.financial.report</field>
        <field name="arch" type="xml">
            <form string="Contract Retention &amp; Advance Report"
                  class="cra_report_single_screen"
                  js_class="cra_report_form"
                  create="0"
                  delete="0">

                <sheet>
                    <field name="report_generated" invisible="1"/>

                    <!--
                        This wrapper animates between its natural height
                        and zero height without removing the filter fields.
                    -->
                    <div class="cra_report_filter_slide">
                        <div class="cra_report_filter_slide_inner">
                            <div class="cra_report_filter_panel">

                                <!-- Output buttons above Get Report -->
                                <div class="cra_report_panel_buttons cra_report_buttons_stacked">
                                    <div class="cra_report_output_buttons">
                                        <button name="action_print"
                                                type="object"
                                                class="btn btn-secondary"
                                                invisible="not report_generated">
                                            <span>Print</span>
                                            <i class="fa fa-print ms-2"
                                               aria-hidden="true"/>
                                        </button>

                                        <button name="action_pdf"
                                                type="object"
                                                class="btn btn-secondary"
                                                invisible="not report_generated">
                                            <span>PDF</span>
                                            <i class="fa fa-file-pdf-o ms-2"
                                               aria-hidden="true"/>
                                        </button>

                                        <button name="action_export"
                                                type="object"
                                                class="btn btn-secondary"
                                                invisible="not report_generated">
                                            <span>Excel</span>
                                            <i class="fa fa-file-excel-o ms-2"
                                               aria-hidden="true"/>
                                        </button>
                                    </div>

                                    <button name="action_compute"
                                            string="Get Report"
                                            type="object"
                                            class="btn btn-primary cra_report_get_button"/>
                                </div>

                                <!-- Filters -->
                                <div class="cra_report_filter_item">
                                    <label for="date_from"/>
                                    <field name="date_from"/>
                                </div>

                                <div class="cra_report_filter_item">
                                    <label for="date_to"/>
                                    <field name="date_to"/>
                                </div>

                                <div class="cra_report_filter_item">
                                    <label for="company_id"/>
                                    <field name="company_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           domain="[('id', 'in', context.get('allowed_company_ids', []))]"/>
                                </div>

                                <div class="cra_report_filter_item">
                                    <label for="partner_id"/>
                                    <field name="partner_id"/>
                                </div>

                                <div class="cra_report_filter_item">
                                    <label for="project_id"/>
                                    <field name="project_id"/>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- The controller inserts the eye control here. -->

                    <!-- Title and generated date range -->
                    <div class="cra_report_results_title">
                        <h1>Contract Retention &amp; Advance Report</h1>

                        <div class="cra_report_date_range"
                             invisible="not report_generated">
                            <span>From</span>
                            <field name="generated_date_from"
                                   readonly="1"
                                   nolabel="1"/>
                            <span>To</span>
                            <field name="generated_date_to"
                                   readonly="1"
                                   nolabel="1"/>
                        </div>
                    </div>

                    <!-- Generated report table -->
                    <div class="cra_report_table_area"
                         invisible="not report_generated">
                        <field name="line_ids"
                               nolabel="1"
                               widget="section_and_note_one2many">
                            <list create="0" edit="0" delete="0">
                                <field name="display_type"
                                       column_invisible="True"/>
                                <field name="name"
                                       string="Customer"
                                       widget="section_and_note_text"/>
                                <field name="company_id"/>
                                <field name="project_id"/>
                                <field name="currency_id"/>
                                <field name="gross" string="Gross invoiced"/>
                                <field name="held" string="Net held"/>
                                <field name="released"/>
                                <field name="retention"
                                       string="Remaining retention"/>
                                <field name="received"
                                       string="Advance received"/>
                                <field name="recovered"/>
                                <field name="advance"
                                       string="Remaining advance"/>
                                <field name="payable"
                                       string="Payable before cash"/>
                                <field name="company_currency_id"
                                       optional="show"/>
                                <field name="company_retention"
                                       optional="show"/>
                                <field name="company_advance"
                                       optional="show"/>

                                <button name="action_invoices"
                                        invisible="display_type"
                                        type="object"
                                        string="Invoices"/>
                                <button name="action_advances"
                                        invisible="display_type"
                                        type="object"
                                        string="Advances"/>
                                <button name="action_movements"
                                        invisible="display_type"
                                        type="object"
                                        string="Movements"/>
                            </list>
                        </field>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="financial_report_action" model="ir.actions.act_window">
        <field name="name">Contract Retention &amp; Advance Report</field>
        <field name="res_model">contract.financial.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="retention_release_multi" model="ir.actions.server">
        <field name="name">Release Retention</field>
        <field name="model_id" ref="model_contract_retention"/>
        <field name="binding_model_id" ref="model_contract_retention"/>
        <field name="state">code</field>
        <field name="code">action = records.action_release()</field>
    </record>

    <!-- Existing standalone summary list retained -->
    <record id="financial_report_summary_list" model="ir.ui.view">
        <field name="name">contract.financial.report.summary.list</field>
        <field name="model">contract.financial.report.line</field>
        <field name="arch" type="xml">
            <list string="Contract Retention &amp; Advance Report"
                  create="0"
                  edit="0"
                  delete="0">
                <header>
                    <button name="action_report_refresh"
                            type="object"
                            string="Refresh"
                            display="always"/>
                    <button name="action_report_filters"
                            type="object"
                            string="Filters / As-of Date"
                            display="always"/>
                    <button name="action_report_export"
                            type="object"
                            string="Export Excel"
                            display="always"/>
                </header>

                <field name="partner_id" string="Customer"/>
                <field name="company_id"/>
                <field name="project_id"/>
                <field name="currency_id"/>
                <field name="gross" string="Gross invoiced"/>
                <field name="held" string="Net held"/>
                <field name="released"/>
                <field name="retention" string="Remaining retention"/>
                <field name="received" string="Advance received"/>
                <field name="recovered"/>
                <field name="advance" string="Remaining advance"/>
                <field name="payable" string="Payable before cash"/>
                <field name="company_currency_id"
                       string="Company currency"
                       optional="show"/>
                <field name="company_retention"
                       string="Company retention"
                       optional="show"/>
                <field name="company_advance"
                       string="Company advance"
                       optional="show"/>

                <button name="action_invoices"
                        type="object"
                        string="Invoices"/>
                <button name="action_advances"
                        type="object"
                        string="Advances"/>
                <button name="action_movements"
                        type="object"
                        string="Movements"/>
            </list>
        </field>
    </record>

    <record id="financial_report_summary_search" model="ir.ui.view">
        <field name="name">contract.financial.report.summary.search</field>
        <field name="model">contract.financial.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="project_id"/>
                <field name="currency_id"/>
            </search>
        </field>
    </record>

    <record id="financial_report_open_summary" model="ir.actions.server">
        <field name="name">Contract Retention &amp; Advance Report</field>
        <field name="model_id" ref="model_contract_financial_report"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_summary()</field>
    </record>

</odoo>